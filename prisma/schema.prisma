// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
  OWNER
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  REGISTERED
  PRESENT
  ABSENT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// How a member pays for an Activity. Lives on Membership, never inferred from
// past payments (AD-7). Resolved as a function of the billing period.
enum PaymentMode {
  MONTHLY
  PER_SESSION
}

// What a Payment row bills for. MONTHLY rows are one-per-member/Activity/period;
// SESSION rows are one-per-member/ActivitySession (per-session pre-pay). A single
// Payment model carries both (AD-4) — no separate session-payment table.
enum PaymentType {
  MONTHLY
  SESSION
}

// ─── NextAuth Required Models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ───────────────────────────────────────────────────────

model User {
  id                String      @id @default(cuid())
  name              String?
  email             String?     @unique
  emailVerified     DateTime?
  image             String?
  phone             String?
  role              Role        @default(MEMBER)
  isActive          Boolean     @default(true)
  isProfileComplete Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  accounts    Account[]
  sessions    Session[]
  attendances Attendance[]
  payments    Payment[]
  memberships Membership[]
}

// An extracurricular activity (ekskul) — e.g. Badminton, Music. Each piece of
// activity data (sessions, payments, memberships) is scoped to one Ekskul.
model Ekskul {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique // e.g. "badminton"
  description     String?  @db.Text
  color           String   @default("#16a34a") // badge color (inline style)
  icon            String? // optional lucide icon name
  monthlyFee       Int     @default(0) // consolidated monthly dues per Activity (AR-7)
  sessionFee       Int     @default(0) // default per-session price inherited by new Sessions (FR-8)
  allowsMonthly    Boolean @default(true) // Activity offers the Monthly payment mode (FR-9)
  allowsPerSession Boolean @default(false) // Activity offers the Per-Session payment mode (FR-9)
  // Cost-sharing viability: how many paying members the Activity needs per
  // session to cover shared costs (venue rent, equipment). 0 = no minimum.
  minMembers       Int     @default(0)
  // Weekly recurring schedule for auto-generated sessions. Day is 0 (Sunday)
  // through 6 (Saturday); null disables auto-generation.
  recurringDay       Int?
  recurringStartTime String @default("08:00")
  recurringEndTime   String @default("10:00")
  defaultLocation String   @default("")
  maxPlayers      Int      @default(20)
  adminWhatsapp   String   @default("")
  logoUrl         String   @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships Membership[]
  sessions    ActivitySession[]
  payments    Payment[]
}

// Many-to-many join between User and Ekskul. A member can join several ekskul.
model Membership {
  id       String   @id @default(cuid())
  userId   String
  ekskulId String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  // Payment mode is owned by the Membership and period-resolved (AD-7). A null
  // paymentMode is the explicit "unselected" state (the member has not chosen
  // yet on an Activity that offers both modes). effectiveFrom is the YYYYMM the
  // current mode applies from; a queued switch is held in pendingMode /
  // pendingEffectiveFrom and only takes effect from its own period forward, so
  // the current period is never rewritten.
  paymentMode          PaymentMode?
  effectiveFrom        Int          @default(0)
  pendingMode          PaymentMode?
  pendingEffectiveFrom Int?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ekskul Ekskul @relation(fields: [ekskulId], references: [id], onDelete: Cascade)

  @@unique([userId, ekskulId])
  @@index([ekskulId])
}

// A generic activity session scoped to an Ekskul. Named ActivitySession (not
// Session) to avoid colliding with the NextAuth `Session` model.
model ActivitySession {
  id          String        @id @default(cuid())
  title       String
  date        DateTime
  startTime   String        // e.g. "08:00"
  endTime     String        // e.g. "10:00"
  location    String
  maxPlayers  Int           @default(20)
  fee         Int           @default(0) // iuran per sesi, dalam Rupiah
  notes       String?       @db.Text
  status      SessionStatus @default(SCHEDULED)
  ekskulId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ekskul      Ekskul       @relation(fields: [ekskulId], references: [id])
  attendances Attendance[]
  payments    Payment[]

  @@index([ekskulId])
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  sessionId String
  status    AttendanceStatus @default(REGISTERED)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  ekskulId    String
  // What this row bills for. MONTHLY (sessionId = null) is one row per
  // member/Activity/month/year; SESSION carries a sessionId and is one row per
  // member/ActivitySession (AD-4). Defaults to MONTHLY so pre-existing rows and
  // the monthly proof-upload flow keep working unchanged (NFR-8).
  type        PaymentType   @default(MONTHLY)
  // Set only on SESSION rows. Its month/year/ekskulId are derived server-side
  // from the ActivitySession (AD-4). Restrict so a paid session cannot be
  // silently deleted out from under a payment record.
  sessionId   String?
  amount      Int           // dalam Rupiah
  month       Int           // 1-12
  year        Int
  status      PaymentStatus @default(PENDING)
  proofUrl    String?       // URL bukti pembayaran di Supabase Storage
  proofPath   String?       // Storage path untuk keperluan delete
  notes       String?       @db.Text
  confirmedBy String?       // userId admin yang konfirmasi
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ekskul  Ekskul           @relation(fields: [ekskulId], references: [id])
  session ActivitySession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  // SESSION uniqueness: one payment per member per session. NULLs are distinct
  // in Postgres, so MONTHLY rows (sessionId = null) are unaffected here — their
  // uniqueness is enforced by a PARTIAL unique index applied via raw SQL (see
  // prisma/payment-monthly-unique.sql), which `db push` cannot express (AD-5).
  @@unique([userId, sessionId])
  @@index([ekskulId])
  @@index([sessionId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
