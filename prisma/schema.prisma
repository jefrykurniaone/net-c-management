// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
  OWNER
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  REGISTERED
  PRESENT
  ABSENT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// ─── NextAuth Required Models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ───────────────────────────────────────────────────────

model User {
  id                String      @id @default(cuid())
  name              String?
  email             String?     @unique
  emailVerified     DateTime?
  image             String?
  phone             String?
  role              Role        @default(MEMBER)
  isActive          Boolean     @default(true)
  isProfileComplete Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  accounts    Account[]
  sessions    Session[]
  attendances Attendance[]
  payments    Payment[]
  memberships Membership[]
}

// An extracurricular activity (ekskul) — e.g. Badminton, Music. Each piece of
// activity data (sessions, payments, memberships) is scoped to one Ekskul.
model Ekskul {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique // e.g. "badminton"
  description     String?  @db.Text
  color           String   @default("#16a34a") // badge color (inline style)
  icon            String? // optional lucide icon name
  defaultFee      Int      @default(0)
  defaultLocation String   @default("")
  maxPlayers      Int      @default(20)
  adminWhatsapp   String   @default("")
  logoUrl         String   @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships Membership[]
  sessions    ActivitySession[]
  payments    Payment[]
}

// Many-to-many join between User and Ekskul. A member can join several ekskul.
model Membership {
  id       String   @id @default(cuid())
  userId   String
  ekskulId String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ekskul Ekskul @relation(fields: [ekskulId], references: [id], onDelete: Cascade)

  @@unique([userId, ekskulId])
  @@index([ekskulId])
}

// A generic activity session scoped to an Ekskul. Named ActivitySession (not
// Session) to avoid colliding with the NextAuth `Session` model.
model ActivitySession {
  id          String        @id @default(cuid())
  title       String
  date        DateTime
  startTime   String        // e.g. "08:00"
  endTime     String        // e.g. "10:00"
  location    String
  maxPlayers  Int           @default(20)
  fee         Int           @default(0) // iuran per sesi, dalam Rupiah
  notes       String?       @db.Text
  status      SessionStatus @default(SCHEDULED)
  ekskulId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ekskul      Ekskul       @relation(fields: [ekskulId], references: [id])
  attendances Attendance[]

  @@index([ekskulId])
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  sessionId String
  status    AttendanceStatus @default(REGISTERED)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  ekskulId    String
  amount      Int           // dalam Rupiah
  month       Int           // 1-12
  year        Int
  status      PaymentStatus @default(PENDING)
  proofUrl    String?       // URL bukti pembayaran di Supabase Storage
  proofPath   String?       // Storage path untuk keperluan delete
  notes       String?       @db.Text
  confirmedBy String?       // userId admin yang konfirmasi
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ekskul Ekskul @relation(fields: [ekskulId], references: [id])

  @@unique([userId, ekskulId, month, year])
  @@index([ekskulId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
