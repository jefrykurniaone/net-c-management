# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is excluded from ignore (safe template for onboarding)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/

# prisma generated client (migrations under prisma/migrations/ ARE committed)
prisma/generated/

# local file uploads (user-uploaded content should not be committed)
uploads/
public/uploads/

# local planning notes (not part of the project)
plans/

# QA docs & generated test-case reports (local artifacts, not app source).
# docs/agents/ is the exception — agent-skill config that must travel with the repo.
docs/*
!docs/agents/

# Playwright MCP browser artifacts
.playwright-mcp/

# Design handoff (vendored design artifact — not app source)
Sports Community Management UI-handoff/

# Throwaway UI-verification screenshots
app-*.png

# RTK (Rust Token Killer) local state
.rtk/

# Agent-tool local state: settings, scheduled-task locks and git worktrees under
# .claude/, and the /impeccable skill's scratch dir. Machine-local, not source.
.claude/
.impeccable/
